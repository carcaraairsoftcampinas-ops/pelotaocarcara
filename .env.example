# Copie este arquivo para ".env" para rodar localmente (netlify dev).
# Em produção, configure as MESMAS variáveis em Netlify > Site settings >
# Environment variables (veja o SETUP.md para o passo a passo completo).

# --- Google OAuth (login) ---
# Mesmo Client ID usado nos dois lados: front-end (prefixo VITE_) e função
# auth-login (sem prefixo).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Sessão ---
# Qualquer string longa e aleatória (ex: gerada com `openssl rand -hex 32`).
JWT_SECRET=

# --- Primeiro acesso ---
# E-mails (separados por vírgula) que viram Administrador automaticamente no
# primeiro login, enquanto não existir nenhum colaborador cadastrado.
ADMIN_BOOTSTRAP_EMAILS=seuemail@gmail.com
